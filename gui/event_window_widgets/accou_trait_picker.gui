vbox = {
	name = "accou_trait_picker"
	layoutpolicy_horizontal = expanding
	layoutpolicy_vertical = shrinking
	min_width = 1000
	margin_left = -70
	margin_right = 80
	spacing = 8

	hbox = {
		layoutpolicy_horizontal = expanding
		position = { 0 -90 }
		margin_left = 90
		margin_right = 370

		editbox_standard_with_label = {
			layoutpolicy_horizontal = expanding
			blockoverride "editbox_properties" {
				name = "enter_text"
				focus_on_visible = yes
				ontextedited = "[EventWindowWidgetEnterText.OnEdit]"
			}
			blockoverride "editbox_label" {
				text = accou_trait_picker.search
			}
		}
	}

	hbox = {
		layoutpolicy_horizontal = expanding
		position = { 0 -90 }
		margin_left = -105
		margin_right = 205

		scrollbox = {
			min_width = 900
			max_width = 900
			min_height = 90
			max_height = 90

			blockoverride "scrollbox_content" {
				vbox = {
					layoutpolicy_horizontal = expanding
					datamodel = "[GetTraits]"

					item = {
						fixedgridbox = {
							addcolumn = 880
							addrow = 42
							visible = "[Or(Not(GetPlayer.MakeScope.Var('accou_trait_search_holder').IsSet), Or(EqualTo_string(Trait.GetKey, GetPlayer.MakeScope.Var('accou_trait_search_holder').Char.GetLocalizedText('accou_trait_search')), Or(EqualTo_string(Trait.GetNameNoTooltip(GetPlayer), GetPlayer.MakeScope.Var('accou_trait_search_holder').Char.GetLocalizedText('accou_trait_search')), Or(EqualTo_string(Trait.GetKey, Localize(Concatenate('accou_trait_alias_01_', GetPlayer.MakeScope.Var('accou_trait_search_holder').Char.GetLocalizedText('accou_trait_search')))), Or(EqualTo_string(Trait.GetKey, Localize(Concatenate('accou_trait_alias_02_', GetPlayer.MakeScope.Var('accou_trait_search_holder').Char.GetLocalizedText('accou_trait_search')))), Or(EqualTo_string(Trait.GetKey, Localize(Concatenate('accou_trait_alias_03_', GetPlayer.MakeScope.Var('accou_trait_search_holder').Char.GetLocalizedText('accou_trait_search')))), Or(EqualTo_string(Trait.GetKey, Localize(Concatenate('accou_trait_alias_04_', GetPlayer.MakeScope.Var('accou_trait_search_holder').Char.GetLocalizedText('accou_trait_search')))), Or(EqualTo_string(Trait.GetKey, Localize(Concatenate('accou_trait_alias_05_', GetPlayer.MakeScope.Var('accou_trait_search_holder').Char.GetLocalizedText('accou_trait_search')))), Or(EqualTo_string(Trait.GetKey, Localize(Concatenate('accou_trait_alias_06_', GetPlayer.MakeScope.Var('accou_trait_search_holder').Char.GetLocalizedText('accou_trait_search')))), Or(EqualTo_string(Trait.GetKey, Localize(Concatenate('accou_trait_alias_07_', GetPlayer.MakeScope.Var('accou_trait_search_holder').Char.GetLocalizedText('accou_trait_search')))), EqualTo_string(Trait.GetKey, Localize(Concatenate('accou_trait_alias_08_', GetPlayer.MakeScope.Var('accou_trait_search_holder').Char.GetLocalizedText('accou_trait_search'))))))))))))))]"
							datamodel = "[DataModelFirst(EventWindowData.GetOptions, '(int32)1')]"

							item = {
								button_standard_list = {
									layoutpolicy_horizontal = expanding
									size = { 880 42 }
									shortcut = confirm
									shortcut = confirm_2
									onclick = "[GetScriptedGui('accou_select_education_trait').Execute(GuiScope.SetRoot(GetPlayer.MakeScope).AddScope('selected_trait', Trait.MakeScope).End)]"
									onclick = "[EventOption.Select]"

									icon = {
										parentanchor = left|vcenter
										position = { 8 0 }
										size = { 34 34 }
										texture = "[Trait.GetIcon(GetPlayer)]"
									}
									text_single = {
										parentanchor = left|vcenter
										position = { 52 0 }
										min_width = 810
										text = "[Trait.GetNameNoTooltip(GetPlayer)]"
										using = Font_Size_Medium
									}
								}
							}
						}
					}
				}
			}
		}
	}
}
